rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true);
    }
    
    match /perfis/{userId} {
      allow read: if true; // Vitrine é pública para leitura
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    match /{collection}/{document=**} {
      // Permitir acesso apenas se o documento tiver userId igual ao UID do request
      allow read, update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }
  }
}
